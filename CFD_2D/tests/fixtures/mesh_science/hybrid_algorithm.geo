// Fixed TAREA-05 fixture: the same curved BL/field topology for algorithms 5/6.
Mesh.MshFileVersion = 2.2;
Mesh.Algorithm = __ALGORITHM__;
Mesh.RandomSeed = 1;
Mesh.RandomFactor = 1e-7;
Mesh.MeshSizeFromPoints = 0;
Mesh.MeshSizeFromCurvature = 0;
Mesh.MeshSizeExtendFromBoundary = 0;
Point(1) = {0, 0, 0, 1};
Point(2) = {5, 0, 0, 1};
Point(3) = {0, 5, 0, 1};
Point(4) = {-5, 0, 0, 1};
Point(5) = {0, -5, 0, 1};
Point(6) = {1, 0, 0, 1};
Point(7) = {0, 0.35, 0, 1};
Point(8) = {-1, 0, 0, 1};
Point(9) = {0, -0.35, 0, 1};
Circle(1) = {2, 1, 3};
Circle(2) = {3, 1, 4};
Circle(3) = {4, 1, 5};
Circle(4) = {5, 1, 2};
Ellipse(5) = {6, 1, 6, 7};
Ellipse(6) = {7, 1, 6, 8};
Ellipse(7) = {8, 1, 6, 9};
Ellipse(8) = {9, 1, 6, 6};
Transfinite Curve {5, 6, 7, 8} = 41;
Curve Loop(1) = {1, 2, 3, 4};
Curve Loop(2) = {-8, -7, -6, -5};
Plane Surface(1) = {1, 2};
Field[1] = BoundaryLayer;
Field[1].CurvesList = {5, 6, 7, 8};
Field[1].Size = 0.002;
Field[1].Ratio = 1.1;
Field[1].Thickness = 0.20;
Field[1].Quads = 1;
Field[2] = Distance;
Field[2].CurvesList = {5, 6, 7, 8};
Field[2].Sampling = 100;
Field[3] = Threshold;
Field[3].InField = 2;
Field[3].SizeMin = 0.05;
Field[3].SizeMax = 0.80;
Field[3].DistMin = 0.20;
Field[3].DistMax = 2.0;
Background Field = 3;
BoundaryLayer Field = 1;
out[] = Extrude {0, 0, 0.02} { Surface{1}; Layers{1}; Recombine; };
Physical Volume("fluid") = {out[1]};
Physical Surface("frontAndBack") = {1, out[0]};
Physical Surface("farfield") = {out[2], out[3], out[4], out[5]};
Physical Surface("airfoil_wall") = {out[6], out[7], out[8], out[9]};
